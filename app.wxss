/* 掼蛋宝 - 全局样式 */
page {
  background: linear-gradient(180deg, #f2efe8 0%, #e8e4dc 100%);
  font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', 'PingFang SC', 'Hiragino Sans GB', 'Microsoft YaHei', sans-serif;
  font-size: 28rpx;
  color: #2c2c2c;
}

.container {
  box-sizing: border-box;
  min-height: 100vh;
  padding: 28rpx 32rpx 48rpx;
}

/* 主色 */
.primary { color: #0f4c81; }
.bg-primary { background-color: #0f4c81; }
.accent { color: #b8860b; }
.bg-accent { background-color: #b8860b; }
