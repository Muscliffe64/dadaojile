.container {
  padding-bottom: 48rpx;
}

.history-entry {
  display: flex;
  align-items: center;
  gap: 18rpx;
  margin: 28rpx 32rpx 0;
  padding: 22rpx 28rpx;
  background: linear-gradient(135deg, #0f4c81 0%, #1a6bb5 100%);
  color: #fff;
  border-radius: 18rpx;
  box-shadow: 0 4rpx 16rpx rgba(15,76,129,0.18);
}
.he-icon {
  font-size: 38rpx;
}
.he-text {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 2rpx;
}
.he-title {
  font-size: 30rpx;
  font-weight: 700;
}
.he-sub {
  font-size: 22rpx;
  opacity: 0.85;
}
.he-arrow {
  font-size: 40rpx;
  opacity: 0.85;
}

.card {
  background: #fff;
  border-radius: 20rpx;
  padding: 32rpx 36rpx;
  margin: 28rpx 32rpx;
  box-shadow: 0 4rpx 24rpx rgba(15,76,129,0.08);
}

.card-title {
  font-size: 34rpx;
  font-weight: 700;
  color: #1a1a1a;
  margin-bottom: 12rpx;
}

.card-hint {
  font-size: 26rpx;
  color: #999;
  display: block;
  margin-bottom: 24rpx;
}

.table-check-group,
.focus-group {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.table-check-item,
.focus-item {
  display: flex;
  align-items: flex-start;
  padding: 16rpx 0;
}

.focus-item {
  min-height: 72rpx;
}

.check-icon {
  width: 40rpx;
  height: 40rpx;
  margin-right: 16rpx;
  border: 2rpx solid #ccc;
  border-radius: 8rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
  color: transparent;
  flex-shrink: 0;
  margin-top: 4rpx;
}

.check-icon.checked {
  background: #0f4c81;
  border-color: #0f4c81;
  color: #fff;
}

.table-check-name {
  font-size: 30rpx;
  color: #1a1a1a;
}

.table-check-count {
  font-size: 24rpx;
  color: #999;
  margin-left: 8rpx;
}

.focus-text {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 4rpx;
  min-width: 0;
}

.focus-label {
  font-size: 28rpx;
  color: #1a1a1a;
  font-weight: 500;
}

.focus-desc {
  font-size: 24rpx;
  color: #999;
}

.custom-input {
  width: 100%;
  min-height: 160rpx;
  padding: 20rpx;
  font-size: 28rpx;
  color: #1a1a1a;
  background: #f8f6f3;
  border-radius: 12rpx;
  box-sizing: border-box;
}

.actions {
  padding: 0 32rpx 48rpx;
}

.btn {
  width: 100%;
  margin: 0;
  padding: 28rpx;
  font-size: 32rpx;
  border-radius: 16rpx;
}

.btn-primary {
  background: linear-gradient(135deg, #0f4c81 0%, #1a6bb5 100%);
  color: #fff !important;
}

.btn::after {
  border: none;
}

.footer-link {
  padding: 24rpx;
  text-align: center;
  font-size: 22rpx;
  color: #999;
}
