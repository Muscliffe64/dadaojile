.container {
  padding-bottom: 48rpx;
}

.card {
  background: #fff;
  border-radius: 20rpx;
  padding: 32rpx 36rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 4rpx 24rpx rgba(15,76,129,0.08);
}

.action-card .btn {
  width: 100%;
  height: 96rpx;
  line-height: 96rpx;
  border-radius: 16rpx;
  font-size: 32rpx;
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0;
  margin: 0;
}

.action-card .btn::after {
  border: none;
}

.btn-primary {
  background: linear-gradient(135deg, #0f4c81 0%, #1a6bb5 100%);
  color: #fff !important;
}

.action-card .btn-primary {
  color: #fff !important;
}

.action-hint {
  display: block;
  font-size: 24rpx;
  color: #999;
  margin-top: 16rpx;
  text-align: center;
}

.card-title {
  font-size: 32rpx;
  font-weight: 700;
  color: #1a1a1a;
  margin-bottom: 24rpx;
}

.report-list {
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}

.report-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx 0;
  border-bottom: 1rpx solid #f0ede8;
}

.report-item:last-child {
  border-bottom: none;
}

.report-meta {
  flex: 1;
  min-width: 0;
}

.report-date {
  display: block;
  font-size: 28rpx;
  font-weight: 600;
  color: #1a1a1a;
}

.report-summary {
  font-size: 24rpx;
  color: #666;
  margin-top: 4rpx;
}

.report-arrow {
  font-size: 32rpx;
  color: #999;
  margin-left: 16rpx;
}

.empty-list {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 80rpx 48rpx;
}

.empty-list .empty-text {
  font-size: 28rpx;
  color: #666;
}

.empty-list .empty-hint {
  font-size: 26rpx;
  color: #999;
  margin-top: 12rpx;
}
