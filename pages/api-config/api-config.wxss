.container { padding-bottom: 48rpx; }
.card {
  background: #fff;
  border-radius: 20rpx;
  padding: 32rpx 36rpx;
  margin: 28rpx 32rpx;
  box-shadow: 0 4rpx 24rpx rgba(15,76,129,0.08);
}
.card-title { font-size: 34rpx; font-weight: 700; margin-bottom: 12rpx; }
.card-hint { font-size: 24rpx; color: #999; display: block; margin-bottom: 24rpx; line-height: 1.5; }

.input {
  width: 100%;
  padding: 22rpx 24rpx;
  font-size: 28rpx;
  background: #f8f6f3;
  border-radius: 12rpx;
  box-sizing: border-box;
  margin-bottom: 16rpx;
}

/* DeepSeek API Key 专用：更大点击区 + 明显边框，避免难以点中 */
.apikey-wrap {
  width: 100%;
  margin-bottom: 20rpx;
}
.apikey-input {
  width: 100%;
  min-height: 96rpx;
  padding: 28rpx;
  font-size: 30rpx;
  color: #222;
  background: #fff;
  border: 2rpx solid #cfd6df;
  border-radius: 14rpx;
  box-sizing: border-box;
  margin-bottom: 0;
}
.apikey-input:focus,
.apikey-input.is-focus {
  border-color: #0f4c81;
  background: #fbfdff;
}
.apikey-placeholder {
  color: #9aa3ad;
  font-size: 28rpx;
}

.btn { margin: 0; }
.btn::after { border: none; }
.btn-primary { background: #0f4c81; color: #fff; }

.field-hint {
  font-size: 22rpx;
  color: #999;
  display: block;
  margin-bottom: 16rpx;
  line-height: 1.5;
}

/* 添加行：picker | 数字输入 | 按钮 */
.add-row {
  display: flex;
  align-items: stretch;
  gap: 12rpx;
  margin-bottom: 16rpx;
}
.add-picker {
  flex: 1;
  min-width: 0;
}
.picker-view {
  display: flex;
  align-items: center;
  justify-content: space-between;
  background: #f8f6f3;
  border-radius: 12rpx;
  padding: 22rpx 20rpx;
  font-size: 28rpx;
  color: #333;
  height: 84rpx;
  box-sizing: border-box;
}
.picker-disabled { color: #bbb; }
.picker-text {
  flex: 1;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.picker-arrow {
  margin-left: 12rpx;
  color: #999;
  font-size: 24rpx;
}

.add-input {
  width: 140rpx;
  flex-shrink: 0;
  margin-bottom: 0;
  padding: 22rpx 12rpx;
  text-align: center;
  height: 84rpx;
}

.btn-add {
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #0f4c81;
  color: #fff;
  font-size: 28rpx;
  font-weight: 600;
  padding: 0 28rpx;
  border-radius: 12rpx;
  height: 84rpx;
}

/* 已设置列表 */
.override-section { margin-top: 16rpx; }
.override-section-title {
  font-size: 26rpx;
  color: #666;
  margin-bottom: 8rpx;
}
.override-list {
  border-top: 2rpx solid #eee;
}
.override-item {
  display: flex;
  align-items: center;
  padding: 22rpx 0;
  border-bottom: 2rpx solid #f4f0eb;
  gap: 16rpx;
}
.override-item:last-child { border-bottom: none; }
.override-name {
  flex: 1;
  font-size: 28rpx;
  color: #333;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.override-value {
  font-size: 26rpx;
  color: #0f4c81;
  font-weight: 600;
  min-width: 100rpx;
  text-align: right;
}
.override-del {
  font-size: 24rpx;
  color: #c0392b;
  padding: 6rpx 16rpx;
  border: 2rpx solid #f4cfca;
  border-radius: 8rpx;
}

.empty-row {
  font-size: 26rpx;
  color: #999;
  padding: 24rpx 0;
  text-align: center;
}

.btn-outline {
  background: #fff;
  color: #0f4c81;
  border: 2rpx solid #0f4c81;
}
.btn-outline::after { border: none; }

.cloud-result {
  margin-top: 18rpx;
  padding: 16rpx 20rpx;
  border-radius: 12rpx;
  font-size: 24rpx;
  line-height: 1.55;
  word-break: break-all;
}
.cloud-result.ok {
  background: #eaf6e7;
  color: #2d7a3f;
}
.cloud-result.err {
  background: #fdecec;
  color: #b03a3a;
}

/* 我的云身份 */
.profile-row {
  display: flex;
  align-items: center;
  gap: 20rpx;
  margin-bottom: 24rpx;
  padding: 16rpx 0;
}
.profile-avatar {
  width: 88rpx;
  height: 88rpx;
  border-radius: 50%;
  background: #eee;
  flex-shrink: 0;
}
.profile-avatar-empty {
  display: flex;
  align-items: center;
  justify-content: center;
  background: #0f4c81;
  color: #fff;
  font-size: 36rpx;
  font-weight: 700;
}
.profile-text {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 4rpx;
  min-width: 0;
}
.profile-name {
  font-size: 30rpx;
  font-weight: 700;
  color: #1a1a1a;
}
.profile-openid {
  font-size: 22rpx;
  color: #999;
}

.profile-edit {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}
.profile-avatar-btn {
  font-size: 28rpx;
  padding: 18rpx 0;
  border: 2rpx solid #0f4c81;
  color: #0f4c81;
  background: #fff;
  border-radius: 14rpx;
}
.profile-avatar-btn::after { border: none; }

.profile-name-row {
  display: flex;
  gap: 14rpx;
  align-items: stretch;
}
.profile-name-input {
  flex: 1;
  /* 复用 .apikey-input 的大尺寸样式（最小高度 + 边框 + padding）*/
}
.profile-save-btn {
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  min-width: 120rpx;
  padding: 0 28rpx;
  border-radius: 14rpx;
  background: #d8d3cc;
  color: #fff;
  font-size: 28rpx;
  font-weight: 600;
}
.profile-save-btn.active {
  background: #0f4c81;
}
.profile-edit-hint {
  font-size: 22rpx;
  color: #666;
  line-height: 1.5;
  margin-top: 4rpx;
  word-break: break-all;
}
