.container { padding-bottom: 48rpx; }
.card { background: #fff; border-radius: 20rpx; padding: 32rpx; margin: 28rpx; box-shadow: 0 4rpx 24rpx rgba(15,76,129,0.08); }
.card-title { font-size: 32rpx; font-weight: 700; margin-bottom: 8rpx; }
.table-hint { font-size: 24rpx; color: #999; display: block; margin-bottom: 20rpx; }
.history-list { display: flex; flex-direction: column; gap: 24rpx; }
.history-item { display: flex; justify-content: space-between; align-items: flex-start; padding: 24rpx 0; border-bottom: 1rpx solid #f0ede8; }
.history-item:last-child { border-bottom: none; }
.item-meta { display: flex; justify-content: space-between; margin-bottom: 12rpx; }
.item-date, .item-score { font-size: 26rpx; }
.item-teams { display: flex; align-items: center; gap: 12rpx; margin-bottom: 8rpx; }
.team-cell { display: flex; align-items: center; gap: 8rpx; font-size: 26rpx; }
.vs { font-size: 22rpx; color: #999; }
.item-winner { font-size: 24rpx; color: #0f4c81; display: flex; gap: 8rpx; align-items: baseline; }
.recorder-tag { font-size: 22rpx; color: #999; }
.btn-delete { font-size: 26rpx; color: #c0392b; padding: 8rpx 16rpx; flex-shrink: 0; }
.empty-state { padding: 80rpx; text-align: center; color: #999; }
.item-main { flex: 1; min-width: 0; }

.item-rounds-toggle {
  display: inline-flex;
  align-items: center;
  gap: 6rpx;
  margin-top: 10rpx;
  font-size: 24rpx;
  color: #0f4c81;
  padding: 6rpx 14rpx;
  background: #eef4fb;
  border-radius: 999rpx;
}
.item-rounds-toggle .rt-arrow {
  font-size: 22rpx;
  color: #999;
}
.item-rounds {
  margin-top: 12rpx;
  padding: 12rpx 14rpx;
  background: #fafaf7;
  border-radius: 12rpx;
}
.round-line {
  display: flex;
  align-items: baseline;
  gap: 12rpx;
  padding: 6rpx 0;
  font-size: 24rpx;
  color: #333;
  line-height: 1.5;
}
.round-line + .round-line {
  border-top: 2rpx solid #efece5;
}
.round-line .round-idx {
  font-size: 22rpx;
  color: #999;
  flex-shrink: 0;
  min-width: 88rpx;
}
.round-line .round-text {
  flex: 1;
}
.round-line.win .round-text {
  color: #0f4c81;
  font-weight: 700;
}
.round-line.taoquan .round-text {
  color: #b87333;
}
