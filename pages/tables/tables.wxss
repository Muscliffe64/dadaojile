.container { padding-bottom: 48rpx; }
.card { background: #fff; border-radius: 20rpx; padding: 32rpx; margin: 28rpx; box-shadow: 0 4rpx 24rpx rgba(15,76,129,0.08); }
.card-title { font-size: 34rpx; font-weight: 700; margin-bottom: 24rpx; }
.table-list { margin-bottom: 24rpx; }
.table-item { display: flex; justify-content: space-between; align-items: center; padding: 24rpx 0; border-bottom: 1rpx solid #f0ede8; }
.table-name { font-size: 30rpx; font-weight: 600; display: block; }
.table-count { font-size: 24rpx; color: #999; }
.table-actions { display: flex; gap: 24rpx; }
.action-btn { font-size: 26rpx; color: #0f4c81; }
.action-btn.danger { color: #c0392b; }
.action-btn.cloud-convert { color: #c9a449; font-weight: 600; }
.btn-add { width: 100%; margin: 0; padding: 24rpx; font-size: 30rpx; color: #0f4c81; background: transparent; border: 2rpx dashed #0f4c81; border-radius: 12rpx; }
.btn-add::after { border: none; }

.card-hint {
  display: block;
  font-size: 24rpx;
  color: #999;
  margin: -16rpx 0 24rpx;
  line-height: 1.5;
}
.cloud-loading {
  text-align: center;
  font-size: 26rpx;
  color: #999;
  padding: 32rpx 0;
}
.cloud-empty {
  text-align: center;
  font-size: 26rpx;
  color: #999;
  padding: 24rpx 0;
}
.cloud-item {
  flex-direction: column;
  align-items: stretch;
  gap: 14rpx;
}
.cloud-row-1 {
  display: flex;
  align-items: center;
  justify-content: space-between;
  width: 100%;
}
.cloud-row-3 {
  display: flex;
  justify-content: flex-end;
}
.cloud-row-3 .action-btn {
  font-size: 24rpx;
}

/* 成员展开/收起 */
.members-toggle {
  display: inline-flex;
  align-items: center;
  gap: 6rpx;
  align-self: flex-start;
  font-size: 22rpx;
  color: #0f4c81;
  padding: 6rpx 14rpx;
  background: #eef4fb;
  border-radius: 999rpx;
}
.mt-arrow {
  font-size: 22rpx;
}
.members-list {
  display: flex;
  flex-direction: column;
  gap: 10rpx;
  padding: 12rpx 14rpx;
  background: #fafaf7;
  border-radius: 12rpx;
}
.member-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
}
.m-avatar {
  width: 48rpx;
  height: 48rpx;
  border-radius: 50%;
  background: #ddd;
  flex-shrink: 0;
}
.m-avatar-empty {
  display: flex;
  align-items: center;
  justify-content: center;
  background: #0f4c81;
  color: #fff;
  font-size: 22rpx;
  font-weight: 700;
}
.m-name {
  flex: 1;
  font-size: 26rpx;
  color: #333;
}
.m-role-tag {
  font-size: 20rpx;
  padding: 2rpx 10rpx;
  border-radius: 999rpx;
  font-weight: 600;
}
.m-role-owner {
  background: #0f4c81;
  color: #fff;
}
.m-role-member {
  background: #eaf2fb;
  color: #0f4c81;
}
.members-loading {
  text-align: center;
  font-size: 22rpx;
  color: #999;
  padding: 12rpx 0;
}
.m-kick {
  font-size: 22rpx;
  color: #c0392b;
  padding: 4rpx 14rpx;
  background: #fdecea;
  border-radius: 999rpx;
  font-weight: 600;
  flex-shrink: 0;
}
.cloud-meta {
  display: flex;
  align-items: center;
  gap: 12rpx;
}
.role-tag {
  font-size: 20rpx;
  padding: 4rpx 12rpx;
  border-radius: 999rpx;
  font-weight: 600;
}
.role-owner {
  background: #0f4c81;
  color: #fff;
}
.role-member {
  background: #eaf2fb;
  color: #0f4c81;
}
.member-count {
  font-size: 22rpx;
  color: #999;
}
.invite-row {
  display: flex;
  align-items: center;
  gap: 10rpx;
  padding: 12rpx 16rpx;
  background: #fafaf7;
  border-radius: 10rpx;
}
.invite-label {
  font-size: 22rpx;
  color: #999;
}
.invite-code {
  flex: 1;
  font-size: 28rpx;
  font-weight: 700;
  color: #0f4c81;
  letter-spacing: 4rpx;
  font-family: monospace;
}
.invite-copy {
  font-size: 28rpx;
}
.cloud-actions {
  display: flex;
  gap: 16rpx;
  margin-top: 16rpx;
}
.cloud-actions .btn-add {
  flex: 1;
}
.cloud-add-btn {
  color: #0f4c81;
  border-color: #0f4c81;
}
.cloud-join-btn {
  color: #c9a449;
  border-color: #c9a449;
  border-style: solid;
}
.invite-howto {
  margin-top: 20rpx;
  padding: 18rpx 22rpx;
  background: #fff8e6;
  border-radius: 12rpx;
}
.howto-title {
  display: block;
  font-size: 26rpx;
  font-weight: 700;
  color: #9a5b00;
  margin-bottom: 10rpx;
}
.howto-line {
  display: block;
  font-size: 24rpx;
  color: #6a5018;
  line-height: 1.7;
}
.no-cloud-hint {
  text-align: center;
  color: #999;
  font-size: 26rpx;
  padding: 32rpx;
}
