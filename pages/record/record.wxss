.container {
  padding-bottom: 48rpx;
}

.card {
  background: #fff;
  border-radius: 20rpx;
  padding: 32rpx 36rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 4rpx 24rpx rgba(15,76,129,0.08);
}

.form-item {
  margin-bottom: 36rpx;
}

.form-item-time .label {
  display: block;
  margin-bottom: 8rpx;
}

.form-item-time .written-at {
  display: block;
  font-size: 26rpx;
  color: #666;
}

.form-item:last-of-type {
  margin-bottom: 0;
}

.label {
  font-size: 28rpx;
  color: #333;
}

.label-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 16rpx;
}

.label-row .label {
  margin-bottom: 0;
}

.link {
  font-size: 26rpx;
  color: #0f4c81;
}

.picker {
  background: #f8f6f3;
  border-radius: 14rpx;
  padding: 26rpx 28rpx;
  font-size: 28rpx;
  color: #333;
}

.team-row {
  display: flex;
  gap: 20rpx;
}

.team-row .picker {
  flex: 1;
}

.radio-row {
  display: flex;
  gap: 48rpx;
}

.radio-item {
  display: flex;
  align-items: center;
  font-size: 28rpx;
  color: #333;
}

.radio-item radio {
  margin-right: 12rpx;
}

.input {
  background: #f8f6f3;
  border-radius: 14rpx;
  padding: 26rpx 28rpx;
  font-size: 28rpx;
  color: #333;
}

/* 比分：双级数 + 套圈 */
.score-item .score-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-bottom: 24rpx;
}

.score-picker {
  flex: 1;
}

.score-picker-inner {
  text-align: center;
  font-size: 36rpx;
  font-weight: 700;
  color: #0f4c81;
  padding: 28rpx 24rpx;
  background: #f0f4f8;
  border-radius: 14rpx;
}

.score-colon {
  font-size: 36rpx;
  font-weight: 700;
  color: #666;
}

.taoquan-row {
  display: flex;
  align-items: center;
  gap: 20rpx;
}

.taoquan-label {
  font-size: 28rpx;
  color: #333;
  min-width: 64rpx;
}

.taoquan-checks {
  flex: 1;
  display: flex;
  gap: 16rpx;
}

.taoquan-check {
  flex: 1;
  display: flex;
  align-items: center;
  gap: 12rpx;
  padding: 22rpx 24rpx;
  background: #f8f6f3;
  border-radius: 14rpx;
  font-size: 28rpx;
  color: #333;
  border: 2rpx solid transparent;
}

.taoquan-check.on {
  background: #eaf2fb;
  border-color: #0f4c81;
  color: #0f4c81;
}

.taoquan-check .check-box {
  width: 36rpx;
  height: 36rpx;
  border-radius: 8rpx;
  border: 2rpx solid #ccc;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
  color: transparent;
  background: #fff;
}

.taoquan-check.on .check-box {
  background: #0f4c81;
  border-color: #0f4c81;
  color: #fff;
}

.hint {
  display: block;
  font-size: 24rpx;
  color: #999;
  margin-top: 14rpx;
}

.actions {
  display: flex;
  gap: 24rpx;
  padding: 0 4rpx;
}

.actions .btn {
  flex: 1;
  height: 96rpx;
  line-height: 1;
  border-radius: 16rpx;
  font-size: 32rpx;
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0;
}
.actions .btn::after { border: none; }

.btn-cancel {
  background: #f0ede8;
  color: #666;
}

.btn-submit {
  background: linear-gradient(135deg, #0f4c81 0%, #1a6bb5 100%);
  color: #fff;
}

/* ===== 本局排名（头/二/三/末游） ===== */
.rank-item .label-row {
  margin-bottom: 12rpx;
}

.rank-toggle {
  width: 84rpx;
  height: 48rpx;
  border-radius: 24rpx;
  background: #d8d3cc;
  position: relative;
  transition: background 0.2s;
}
.rank-toggle.on {
  background: #0f4c81;
}
.rank-toggle-dot {
  position: absolute;
  top: 4rpx;
  left: 4rpx;
  width: 40rpx;
  height: 40rpx;
  background: #fff;
  border-radius: 50%;
  box-shadow: 0 2rpx 6rpx rgba(0,0,0,0.18);
  transition: left 0.2s;
}
.rank-toggle.on .rank-toggle-dot {
  left: 40rpx;
}

.rank-hint {
  margin-top: 0;
  margin-bottom: 16rpx;
  line-height: 1.5;
}

.rank-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  margin-bottom: 16rpx;
}
.rank-btn {
  flex: 1 1 calc(50% - 16rpx);
  min-width: calc(50% - 16rpx);
  min-height: 160rpx;
  padding: 22rpx 20rpx;
  border-radius: 18rpx;
  background: #f8f6f3;
  border: 4rpx solid transparent;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  box-sizing: border-box;
  transition: all 0.15s;
}
.rank-btn.disabled {
  opacity: 0.5;
}
/* 双下时未点的 2 个 = 已确定的"败"，灰化但保留信息 */
.rank-btn.tied {
  opacity: 0.55;
  background: #f0ede8;
  border-color: #ddd;
}

/* === 最近搭配 chips === */
.recent-pairings-item .label {
  display: block;
  margin-bottom: 12rpx;
}
.pairing-scroll {
  white-space: nowrap;
  width: 100%;
}
.pairing-chip {
  display: inline-flex;
  align-items: center;
  gap: 10rpx;
  padding: 14rpx 20rpx;
  margin-right: 14rpx;
  background: #fbfaf6;
  border: 2rpx solid #e8e4dc;
  border-radius: 999rpx;
  font-size: 24rpx;
  color: #333;
}
.pairing-chip:active {
  background: #eef4fb;
  border-color: #0f4c81;
}
.pairing-side {
  display: inline-flex;
  align-items: center;
  gap: 6rpx;
}
.pairing-badge {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  width: 28rpx;
  height: 28rpx;
  border-radius: 6rpx;
  font-size: 18rpx;
  font-weight: 700;
  color: #fff;
}
.pairing-badge-1 { background: #0f4c81; }
.pairing-badge-2 { background: #c9a449; }
.pairing-vs {
  font-size: 20rpx;
  color: #999;
  padding: 0 2rpx;
}
.rank-tag-tied {
  font-size: 22rpx;
  color: #888;
  background: #e0dcd4;
  padding: 4rpx 16rpx;
  border-radius: 999rpx;
}
.rank-team {
  font-size: 24rpx;
  color: #888;
}
.rank-name {
  font-size: 36rpx;
  font-weight: 700;
  color: #222;
  text-align: center;
  word-break: break-all;
  line-height: 1.2;
}
.rank-tag {
  font-size: 24rpx;
  color: #666;
  padding: 4rpx 16rpx;
  border-radius: 999rpx;
  background: #eee2d4;
}
.rank-tag-empty {
  color: #aaa;
  background: transparent;
  border: 2rpx dashed #cfc7bd;
}

.rank-btn.picked {
  background: #fff;
}
.rank-btn.picked-1 {
  border-color: #d4af37;
  background: #fff8e3;
}
.rank-btn.picked-1 .rank-tag {
  background: #d4af37;
  color: #fff;
}
.rank-btn.picked-2 {
  border-color: #8e9aab;
  background: #f1f3f6;
}
.rank-btn.picked-2 .rank-tag {
  background: #8e9aab;
  color: #fff;
}
.rank-btn.picked-3 {
  border-color: #b87333;
  background: #fbf1e8;
}
.rank-btn.picked-3 .rank-tag {
  background: #b87333;
  color: #fff;
}
.rank-btn.picked-4 {
  border-color: #888;
  background: #efefef;
}
.rank-btn.picked-4 .rank-tag {
  background: #888;
  color: #fff;
}

.rank-summary {
  display: flex;
  align-items: center;
  justify-content: space-between;
  background: #eaf2fb;
  border-radius: 14rpx;
  padding: 18rpx 22rpx;
}
.rank-summary-text {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}
.rank-summary-line {
  font-size: 26rpx;
  color: #0f4c81;
  line-height: 1.5;
}
.rank-summary-line.strong {
  font-weight: 700;
  font-size: 28rpx;
}
.rank-reset {
  font-size: 24rpx;
  color: #0f4c81;
  padding: 8rpx 18rpx;
  border: 2rpx solid #0f4c81;
  border-radius: 999rpx;
  flex-shrink: 0;
}

/* ===== 比分牌 ===== */
.scoreboard {
  display: flex;
  align-items: stretch;
  background: linear-gradient(135deg, #f5efe2 0%, #faf6ec 100%);
  border-radius: 18rpx;
  padding: 24rpx 20rpx;
  margin-bottom: 20rpx;
  border: 2rpx solid #ecdfbe;
}
.sb-team {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 6rpx;
  position: relative;
  padding: 8rpx;
  border-radius: 12rpx;
}
.sb-team.sb-win {
  background: #fff5d3;
  box-shadow: 0 0 0 2rpx #d4af37 inset;
}
.sb-label {
  font-size: 24rpx;
  color: #888;
}
.sb-level {
  font-size: 64rpx;
  font-weight: 800;
  color: #0f4c81;
  line-height: 1;
}
.sb-taoquan {
  font-size: 22rpx;
  color: #b87333;
  background: #fbf1e8;
  padding: 4rpx 14rpx;
  border-radius: 999rpx;
  margin-top: 4rpx;
}
.sb-mid {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 0 12rpx;
  gap: 4rpx;
  min-width: 100rpx;
}
.sb-rounds {
  font-size: 22rpx;
  color: #999;
}
.sb-vs {
  font-size: 26rpx;
  color: #666;
  font-weight: 600;
}

/* ===== 游戏结束横幅 ===== */
.game-over {
  background: linear-gradient(135deg, #0f4c81 0%, #1a6bb5 100%);
  color: #fff;
  border-radius: 18rpx;
  padding: 28rpx 24rpx;
  margin-bottom: 20rpx;
  text-align: center;
}
.game-over-title {
  font-size: 36rpx;
  font-weight: 800;
  margin-bottom: 8rpx;
}
.game-over-sub {
  font-size: 26rpx;
  opacity: 0.9;
  margin-bottom: 16rpx;
}
.game-over-actions {
  display: flex;
  justify-content: center;
  gap: 16rpx;
}
.game-over .btn-outline-sm {
  border-color: rgba(255,255,255,0.6);
  color: #fff;
  background: transparent;
}
.game-over .btn-outline-sm.danger {
  border-color: #ffd0c8;
  color: #ffd0c8;
}

/* ===== 操作小按钮 ===== */
.btn-commit {
  background: #0f4c81;
  color: #fff;
  font-size: 28rpx;
  font-weight: 700;
  padding: 14rpx 32rpx;
  border-radius: 999rpx;
  white-space: nowrap;
}
.rank-actions {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-left: 16rpx;
  flex-shrink: 0;
}
.btn-outline-sm {
  font-size: 24rpx;
  color: #666;
  padding: 8rpx 20rpx;
  border: 2rpx solid #ccc;
  border-radius: 999rpx;
  background: #fff;
}
.btn-outline-sm.danger {
  color: #c0392b;
  border-color: #f0c8c0;
}
.round-controls {
  display: flex;
  gap: 12rpx;
  justify-content: flex-end;
  margin-bottom: 16rpx;
}

/* ===== 手史 ===== */
.history-block {
  margin-top: 8rpx;
  background: #fafaf7;
  border-radius: 14rpx;
  padding: 16rpx 20rpx;
}
.history-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 4rpx 0;
}
.history-title {
  font-size: 26rpx;
  color: #555;
  font-weight: 600;
}
.history-arrow {
  font-size: 26rpx;
  color: #999;
}
.history-list {
  margin-top: 12rpx;
}
.history-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 10rpx 0;
  border-top: 2rpx solid #eee;
}
.history-row:first-child {
  border-top: none;
}
.history-idx {
  font-size: 22rpx;
  color: #999;
  flex-shrink: 0;
  min-width: 88rpx;
}
.history-text {
  font-size: 24rpx;
  color: #333;
  flex: 1;
  line-height: 1.5;
}
.history-text.win {
  color: #0f4c81;
  font-weight: 700;
}
.history-text.taoquan {
  color: #b87333;
}
